{
  "info": {
    "_postman_id": "araya-m4-api-regression",
    "name": "Araya M4 API Regression",
    "description": "Smoke and regression checks for public documentation and authentication contracts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "OpenAPI JSON is available",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/openapi.json",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "openapi.json"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns OpenAPI 3.0.3', function () { pm.expect(pm.response.json().openapi).to.eql('3.0.3'); });",
              "pm.test('has orders contract', function () { pm.expect(pm.response.json().paths).to.have.property('/orders'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "M4 documentation is public",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/m4/v1/docs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "m4", "v1", "docs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns HTML documentation', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); });",
              "pm.test('contains Swagger UI mount', function () { pm.expect(pm.response.text()).to.include('swagger-ui'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth rejects missing token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('returns standard error envelope', function () { var body = pm.response.json(); pm.expect(body.error.code).to.eql('UNAUTHENTICATED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth returns mock admin profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns admin profile', function () { var body = pm.response.json(); pm.expect(body.data.role).to.eql('Admin'); pm.expect(String(body.data.user_id)).to.eql('1'); });"
            ]
          }
        }
      ]
    }
  ]
}
