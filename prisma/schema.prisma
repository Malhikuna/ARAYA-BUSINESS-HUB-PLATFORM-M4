  tax_rates        tax_rates?        @relation(fields: [tax_rate_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_products_tax_rate")
  partner_profiles partner_profiles  @relation(fields: [partner_id], references: [partner_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_products_services_partner")
