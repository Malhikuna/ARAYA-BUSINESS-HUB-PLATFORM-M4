generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Fallback profil Partner M3 untuk verifikasi tipe_usaha dan is_verified (PRO-305)
model partner_profiles {
  partner_id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @unique @db.Uuid
  tipe_usaha        String              @db.VarChar(20)
  is_verified       Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  products_services products_services[]
  quotations        quotations[]
  orders            orders[]
  invoices          invoices[]
  service_requests  service_requests[]

  @@index([user_id], map: "idx_partner_profiles_user_id")
  @@index([is_verified], map: "idx_partner_profiles_is_verified")
}

/// Permintaan Jasa dari Katalog M5 untuk dibuatkan Penawaran / Quotation (PRO-302)
model service_requests {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id       String           @db.Uuid
  customer_id      String?          @db.Uuid
  customer_user_id String?          @db.Uuid
  customer_name    String           @db.VarChar(150)
  customer_email   String           @db.VarChar(255)
  customer_phone   String           @db.VarChar(20)
  title            String           @db.VarChar(200)
  description      String?
  status           String           @default("baru") @db.VarChar(30)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  partner_profiles partner_profiles @relation(fields: [partner_id], references: [partner_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_service_requests_partner")
  customers        customers?       @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_service_requests_customer")
  quotations       quotations?

  @@index([partner_id], map: "idx_service_requests_partner_id")
  @@index([customer_user_id], map: "idx_service_requests_customer_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customers {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?            @db.Uuid
  name             String             @db.VarChar(150)
  email            String             @unique @db.VarChar(255)
  phone            String             @unique @db.VarChar(20)
  address          String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  invoices         invoices[]
  orders           orders[]
  quotations       quotations[]
  service_requests service_requests[]

  @@index([user_id], map: "idx_customers_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model document_sequences {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_type String   @db.VarChar(20)
  period        String   @db.VarChar(6)
  last_number   BigInt   @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([document_type, period], map: "uq_document_sequence")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoice_items {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id         String            @db.Uuid
  product_service_id String            @db.Uuid
  description        String?
  quantity           Decimal           @db.Decimal(15, 2)
  unit_price         Decimal           @db.Decimal(15, 2)
  discount_amount    Decimal           @default(0) @db.Decimal(15, 2)
  tax_rate           Decimal           @default(0) @db.Decimal(5, 2)
  tax_amount         Decimal           @default(0) @db.Decimal(15, 2)
  subtotal           Decimal           @db.Decimal(15, 2)
  total_amount       Decimal           @db.Decimal(15, 2)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  invoices           invoices          @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_invoice_items_invoice")
  products_services  products_services @relation(fields: [product_service_id], references: [id], onUpdate: NoAction, map: "fk_invoice_items_product")

  @@index([invoice_id], map: "idx_invoice_items_invoice")
  @@index([product_service_id], map: "idx_invoice_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invoices {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_number  String          @unique @db.VarChar(30)
  quotation_id    String?         @unique @db.Uuid
  order_id        String?         @unique @db.Uuid
  customer_id     String          @db.Uuid
  partner_id      String          @db.Uuid
  invoice_date    DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  due_date        DateTime?       @db.Date
  status          String          @default("UNPAID") @db.VarChar(20)
  subtotal        Decimal         @default(0) @db.Decimal(15, 2)
  discount_amount Decimal         @default(0) @db.Decimal(15, 2)
  tax_amount      Decimal         @default(0) @db.Decimal(15, 2)
  total_amount    Decimal         @default(0) @db.Decimal(15, 2)
  paid_at         DateTime?       @db.Timestamptz(6)
  payment_method  String?         @db.VarChar(50)
  snap_token      String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  invoice_items    invoice_items[]
  payments         payments[]
  webhook_events   webhook_events[]
  customers        customers        @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "fk_invoices_customer")
  orders           orders?          @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invoices_order")
  quotations       quotations?      @relation(fields: [quotation_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invoices_quotation")
  partner_profiles partner_profiles @relation(fields: [partner_id], references: [partner_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_invoices_partner")

  @@index([customer_id], map: "idx_invoices_customer")
  @@index([partner_id], map: "idx_invoices_partner")
}

/// Sesi & Riwayat Transaksi Pembayaran Payment Gateway Midtrans Snap (PRO-56 / M4-US3)
model payments {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id        String           @db.Uuid
  provider          String           @default("midtrans") @db.VarChar(30)
  midtrans_order_id String           @unique @db.VarChar(60)
  transaction_id    String?          @unique @db.VarChar(100)
  amount            Decimal          @default(0) @db.Decimal(15, 2)
  status            String           @default("pending") @db.VarChar(30)
  fraud_status      String?          @db.VarChar(20)
  payment_type      String?          @db.VarChar(50)
  snap_token        String?
  redirect_url      String?
  paid_at           DateTime?        @db.Timestamptz(6)
  expired_at        DateTime?        @db.Timestamptz(6)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  invoices          invoices         @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_invoice")
  webhook_events    webhook_events[]

  @@index([invoice_id], map: "idx_payments_invoice_id")
  @@index([status], map: "idx_payments_status")
}

/// Log Audit & Idempotensi Notifikasi Webhook Midtrans (PRO-56 / M4-US3)
model webhook_events {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_key          String    @unique @db.VarChar(150)
  provider           String    @default("midtrans") @db.VarChar(30)
  invoice_id         String?   @db.Uuid
  payment_id         String?   @db.Uuid
  midtrans_order_id  String    @db.VarChar(60)
  transaction_id     String?   @db.VarChar(100)
  transaction_status String    @db.VarChar(30)
  fraud_status       String?   @db.VarChar(20)
  status_code        String?   @db.VarChar(10)
  gross_amount       String    @db.VarChar(30)
  payment_type       String?   @db.VarChar(50)
  signature_key      String    @db.VarChar(150)
  signature_valid    Boolean   @default(false)
  processing_status  String    @default("received") @db.VarChar(30)
  raw_payload        Json
  error_message      String?
  processed_at       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  invoices           invoices? @relation(fields: [invoice_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_webhook_events_invoice")
  payments           payments? @relation(fields: [payment_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_webhook_events_payment")

  @@index([invoice_id], map: "idx_webhook_events_invoice_id")
  @@index([payment_id], map: "idx_webhook_events_payment_id")
  @@index([midtrans_order_id], map: "idx_webhook_events_midtrans_order_id")
  @@index([transaction_id], map: "idx_webhook_events_transaction_id")
}

