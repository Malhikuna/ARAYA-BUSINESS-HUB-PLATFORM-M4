  customers         customers        @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "fk_orders_customer")
  partner_profiles  partner_profiles @relation(fields: [partner_id], references: [partner_id], onDelete: Restrict, onUpdate: Cascade, map: "fk_orders_partner")

